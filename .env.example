APP_ENV=dev

# 通过 SSH 隧道访问服务器的 ai_protection 数据库
DATABASE_URL=postgresql+asyncpg://ariechovi:CHANGE_ME@127.0.0.1:15432/ai_protection
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:16379/0

# 评测 Agent 使用的模型
MODEL_NAME=deepseek-chat
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=CHANGE_ME

# 安全知识 RAG 使用的向量模型
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=CHANGE_ME
VECTOR_DIM=1024

# 受测目标鉴权变量名，值由目标系统自己提供
TARGET_API_KEY=
MAX_TEST_CASES=6
TARGET_TIMEOUT_SECONDS=20
JUDGE_TIMEOUT_SECONDS=60
MEMORY_TIMEOUT_SECONDS=15

